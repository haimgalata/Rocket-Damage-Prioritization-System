# ─────────────────────────────────────────────────────────────────────────────
# PrioritAI — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/

# ── Machine Learning Models ───────────────────────────────────────────────────
# *.keras is tracked via Git LFS (see .gitattributes) — do NOT add it here.
# Other large model formats that are NOT used in this project:
*.h5
*.pt
*.pth
*.onnx

# ── GIS / OSMnx Cache ─────────────────────────────────────────────────────────
cache/
server/cache/
**/osmnx_cache/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
client/dist/
client/dist-ssr/
*.local

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment Variables ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS Generated ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Docker runtime volumes ────────────────────────────────────────────────────
docker-volumes/

# ── Uploads ───────────────────────────────────────────────────────────────────
# Ignore arbitrary uploads
server/uploads/
uploads/*

# Keep gitkeep
!uploads/.gitkeep

# Allow demo/seed assets
!uploads/tel_aviv_*.jpg
!uploads/tel_aviv_*.jpeg
!uploads/tel_aviv_*.png
!uploads/tel_aviv_*.webp

!uploads/jerusalem_*.jpg
!uploads/jerusalem_*.jpeg
!uploads/jerusalem_*.png
!uploads/jerusalem_*.webp

!uploads/south_*.jpg
!uploads/south_*.jpeg
!uploads/south_*.png
!uploads/south_*.webp

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.cache
dist/
.next/
backend.log
*.iml